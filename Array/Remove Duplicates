#include <iostream>
#include <vector>
using namespace std;

vector<int> removeDuplicates(vector<int>&arr) {
    int i = 0;
for (int j = 1; j < arr.size(); j++) {
    if (arr[i] != arr[j]) {
     arr[i + 1] = arr[j];
     i++;
       }
    }
arr.resize(i + 1);
    return arr;
}

int main() {
    vector<int> arr = {1, 1, 2, 2, 2, 3, 3};

    vector<int> ans = removeDuplicates(arr);

    for (int x : ans) {
        cout << x << " ";
    }

    return 0;
}
