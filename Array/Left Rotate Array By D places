#include <iostream>
#include <vector>
#include<algorithm>
using namespace std;

void leftRotate(vector<int>& arr,int d , int n){
    reverse(arr.begin() , arr.begin()+d);
    reverse(arr.begin()+d , arr.end());
    reverse(arr.begin() , arr.end());

}

int main() {
    vector<int>arr = {1,2,3,4,5,6,7};
    int d=3;
    leftRotate(arr,d , arr.size());

    
    for(int val : arr){
        cout<<val<<" ";
    }
    return 0;
}
