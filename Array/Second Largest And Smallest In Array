#include <iostream>
#include<vector>
#include <list>
#include <algorithm>
using namespace std;
int secondLargest( vector<int>&arr){
    int largest = arr[0];
    int secLargest = INT_MIN;
    int n = arr.size();
    for(int i=0;i<n;i++){
        if(arr[i]>largest){
            secLargest = largest;
            largest = arr[i];
        } else if(arr[i]<largest && arr[i]>secLargest){
            secLargest = arr[i];
        }
    }
    return secLargest;
}

int secondSmallest(vector<int>&arr){
    int smallest=arr[0];
    int secSmallest = INT_MAX;
    int n =arr.size();
    for(int i=0;i<n;i++){
        if(arr[i]<smallest){
            secSmallest = smallest;
            smallest = arr[i];
        } else if(arr[i]!=smallest && secSmallest>arr[i]){
            secSmallest = arr[i];
        }
    }
    return secSmallest;
}
int main() {
    vector<int>arr = {1,2,4,7,7,5};

    cout<<"Second Largest Number is ="<<secondLargest(arr)<<endl;
    cout<<"Second Smallest Number is ="<<secondSmallest(arr);

 
    return 0;
}
