#include <iostream>
#include <vector>
using namespace std;

void leftRotate(vector<int>& arr){
    int i=0;
    int j=1;

    while(i<arr.size() && j<arr.size()){
        swap(arr[i] , arr[j]);
        i++; j++;
    }


    for(int i=0;i<arr.size();i++){
        cout<<arr[i]<<" ";
    }
}

int main() {
    vector<int>arr = {1,2,3,4,5};
    leftRotate(arr);
    return 0;
}
