#include<iostream>
#include<vector>
#include<algorithm>
using namespace std;

void printDivision(int n){
    vector<int>ls;
    
    for(int i=1 ; i*i<=n ; i++){
        if(n % i == 0){
            ls.push_back(i);
        
        
        if(n/i != i){
            ls.push_back(n/i);
        }
        }
    }
        sort(ls.begin() , ls.end());
        
        for(auto ans : ls){
            cout<<ans<<"    ";
        }
    
}

    

int main(){
    int n=36;
    printDivision(n);
    return 0;
}
