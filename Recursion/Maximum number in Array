#include <iostream>
using namespace std;

int findMax(int arr[], int n, int index) {

    if (index == n - 1)
        return arr[index];

    int maxOfRest = findMax(arr, n, index + 1);

    return max(arr[index], maxOfRest);
}

int main() {
    int arr[] = {3, 7, 2, 9, 4};
    int n = 5;
   cout << findMax(arr, n, 0);
    return 0;
}
